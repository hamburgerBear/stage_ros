    #bpose[0] [0.000000 -0.165000 0.04 90.000000]
    # bpose[1] [0.032190 -0.161830 0.04 101.250000]
    # bpose[2] [0.063143 -0.152440 0.04 112.500000]
    # bpose[3] [0.091669 -0.137192 0.04 123.750000]
    # bpose[4] [0.116673 -0.116673 0.04 135.000000]
    # bpose[5] [0.137192 -0.091669 0.04 146.250000]
