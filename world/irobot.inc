
define roomba position
(
  size [0.32 0.32 0.1] 

  # this block approximates the circular shape of a Roomba
  block( 
    points 16
    point[0] [ 0.225 0.000 ]
    point[1] [ 0.208 0.086 ]
    point[2] [ 0.159 0.159 ]
    point[3] [ 0.086 0.208 ]
    point[4] [ 0.000 0.225 ]
    point[5] [ -0.086 0.208 ]
    point[6] [ -0.159 0.159 ]
    point[7] [ -0.208 0.086 ]
    point[8] [ -0.225 0.000 ]
    point[9] [ -0.208 -0.086 ]
    point[10] [ -0.159 -0.159 ]
    point[11] [ -0.086 -0.208 ]
    point[12] [ -0.000 -0.225 ]
    point[13] [ 0.086 -0.208 ]
    point[14] [ 0.159 -0.159 ]
    point[15] [ 0.208 -0.086 ]
    z [0 0.1]
  )

  # this bumper array VERY crudely approximates the Roomba's bumpers
  # 左碰
  bumper( size [0.02 0.02 0.01 0]
    bcount 2
    blength .06
    bpose[0] [0.032190 0.161830 0.04 -101.250000]
    bpose[1] [0.063143 0.152440 0.04 -112.500000]
  )

  # 左前碰
  bumper( size [0.02 0.02 0.01 0]
    bcount 4
    blength .06
    bpose[0] [0.091669 0.137192 0.04 -123.750000]
    bpose[1] [0.116673 0.116673 0.04 -135.000000]
    bpose[2] [0.137192 0.091669 0.04 -146.250000]
    bpose[3] [0.152440 0.063143 0.04 -157.500000]
  )

  # 前碰
  bumper( size [0.02 0.02 0.01 0]
    bcount 3
    blength .06
    bpose[0] [0.161830 0.032190 0.04 -168.750000]
    bpose[1] [0.165000 0.000000 0.04 -180.000000]
    bpose[2] [0.161830 -0.032190 0.04 168.750000]
  )

  # 右前碰
  bumper( size [0.02 0.02 0.01 0]
    bcount 4
    blength .06
    bpose[0] [0.091669 -0.137192 0.04 123.750000]
    bpose[1] [0.116673 -0.116673 0.04 135.000000]
    bpose[2] [0.137192 -0.091669 0.04 146.250000]
    bpose[3] [0.152440 -0.063143 0.04 157.500000]
  )
 
  # 右碰
  bumper( size [0.02 0.02 0.01 0]
    bcount 2
    blength .06
    bpose[0] [0.032190 -0.161830 0.04 101.250000]
    bpose[1] [0.063143 -0.152440 0.04 112.500000]
  )


  # bumper( size [0.01 0.01 0.01 0]
